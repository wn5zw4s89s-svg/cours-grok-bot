---
import '../styles/site.css';
import site from '../data/site.json';
const { title, page = '' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const meta = {
  base,
  niveaux: site.niveaux,
  lecons: site.lecons.map((l) => ({ id: l.id, num: l.num, niveau: l.niveau, court: l.court, disponible: l.disponible, numLabel: l.numLabel })),
  quiz: site.quiz.map((q) => ({ id: q.id, slug: q.slug, titre: q.titre, nb: q.questions.length, niveau: q.niveau })),
};
---
<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title ? `${title} · Cours Grok Bot` : 'Cours Grok Bot'}</title>
  <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
</head>
<body data-page={page}>
  <header class="top">
    <a class="logo" href={base}><span class="logo-dot">G</span></a>
    <span class="niveau-badge" data-niveau>Niveau 1</span>
  </header>
  <main><slot /></main>
  <script type="application/json" id="gb-meta" set:html={JSON.stringify(meta)} />
  <script is:inline src={`${base}jeu.js`} defer></script>
</body>
</html>
