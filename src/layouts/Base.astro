---
import '../styles/site.css';
import site from '../data/site.json';
import octo from '../data/octoboss.json';
import { clair } from '../lib/clair.js';
import { DEV_TOUT_OUVERT } from '../config.js';
import { readFileSync } from 'node:fs';
import { createHash } from 'node:crypto';
import { buildId } from '../lib/build.js';
const jsv = buildId;
const { title, page = '' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const meta = {
  base,
  build: jsv,
  dev: DEV_TOUT_OUVERT,
  octo,
  niveaux: site.niveaux,
  projets: site.projets,
  labelUnite: site.labelUnite || 'Niveau',
  lecons: site.lecons.map((l) => ({ id: l.id, num: l.num, niveau: l.niveau, court: l.court, disponible: l.disponible, numLabel: l.numLabel, pos: l.pos, tot: l.tot, label: l.label, clair: clair(l).titre, but: clair(l).but })),
  quiz: site.quiz.map((q) => ({ id: q.id, slug: q.slug, titre: q.titre, nb: q.questions.length, niveau: q.niveau })),
};
---
<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="theme-color" content="#06161A" />
  <title>{title ? `${title} · OctoBoss` : `OctoBoss — ${octo.slogan}`}</title>
  <meta name="description" content={`OctoBoss — ${octo.slogan}. Le cours Grok Bot gratuit, en ${site.projets.filter((p) => Number.isInteger(p.id)).length} projets.`} />
  <meta property="og:title" content={`OctoBoss — ${octo.slogan}`} />
  <script is:inline define:vars={{ base, jsv }}>
  // Vérif de version au plus tôt (avant le corps) : HTML périmé en cache -> rechargement ?v=<build>.
  (function () {
    var KEY = 'gb2:build-reload';
    try {
      var u0 = new URL(location.href);
      if (u0.searchParams.get('v') === jsv) sessionStorage.removeItem(KEY);
      fetch(base + 'version.json?_=' + Date.now(), { cache: 'no-store' })
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (v) {
          if (!v || !v.build || v.build === jsv) return;
          if (sessionStorage.getItem(KEY) === v.build) return; // une seule tentative par build
          sessionStorage.setItem(KEY, v.build);
          var u = new URL(location.href);
          u.searchParams.delete('_v');
          u.searchParams.set('v', v.build);
          location.replace(u.toString());
        })
        .catch(function () {});
    } catch (e) {}
  })();
  </script>
  <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
</head>
<body data-page={page}>
  <header class="top">
    <a class="logo" href={base}>Octo<b>Boss</b></a>
    {page === 'accueil' && <button type="button" class="ico-liste" data-sheet-open aria-label="Toutes les leçons"><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg></button>}
  </header>
  <main><slot /></main>
  <script type="application/json" id="gb-meta" set:html={JSON.stringify(meta)} />
  <script is:inline src={`${base}jeu.js?v=${jsv}`} defer></script>
</body>
</html>
