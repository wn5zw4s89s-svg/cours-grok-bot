---
import Base from '../../layouts/Base.astro';
import site from '../../data/site.json';
export function getStaticPaths() { return site.quiz.map((q) => ({ params: { id: q.slug }, props: { q } })); }
const { q } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Base title={q.titre} page="quiz">
  <article class="quiz-page">
    <a class="retour" href={base}>← Accueil</a>
    <p class="surtitre">Quiz · Niveau {q.niveau}</p>
    <h1>{q.titre}</h1>
    <div class="verrou" data-quiz-verrou hidden>
      <p>🔒 Termine les leçons du niveau {q.niveau} pour ouvrir ce quiz.</p>
      <a class="btn" data-quiz-suite href={base}>Continuer</a>
    </div>
    <div class="quiz" data-quiz={JSON.stringify(q)} data-niveau={q.niveau}></div>
  </article>
</Base>
