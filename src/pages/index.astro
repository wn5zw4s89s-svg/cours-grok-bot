---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Base page="accueil">
  <section class="hero-min">
    <h1>Cours Grok Bot</h1>
    <p class="objectif" data-objectif>0/5 avant Apprenti</p>
    <div class="barre"><span data-barre-niv></span></div>
    <a class="btn btn-large" data-continuer href={`${base}lecon/${site.lecons[0].id}/`}>Commencer</a>
    <p class="prochain-badge" data-prochain-badge></p>
  </section>

  {site.niveaux.map((niv) => {
    const lecs = site.lecons.filter((l) => l.niveau === niv.id);
    const quiz = site.quiz.find((q) => q.id === niv.quizId);
    return (
      <details class="niv" data-niveau-bloc={niv.id}>
        <summary><span class="niv-nom">Niveau {niv.id} · {niv.nom}</span><span class="niv-etat" data-niv-etat={niv.id}>{lecs.length} leçons</span></summary>
        <ol class="liste-compacte">
          {lecs.map((l) => (
            <li class="item-lecon" data-lecon-carte={l.id}>
              <a href={`${base}lecon/${l.id}/`}>
                <span class="pastille" data-etat>{l.num}</span>
                <span class="titre">{l.court}</span>
                <span class="cadenas" aria-hidden="true">🔒</span>
              </a>
            </li>
          ))}
        </ol>
        {quiz && <a class="lien-quiz" href={`${base}quiz/${quiz.slug}/`} data-quiz-lien={quiz.id} data-quiz-niv={niv.id}>Quiz</a>}
      </details>
    );
  })}

  <p class="discret centre"><button class="lien" data-reset>Recommencer</button></p>
</Base>
