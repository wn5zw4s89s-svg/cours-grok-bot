---
import Base from '../layouts/Base.astro';
import { clair } from '../lib/clair.js';
import Octo from '../components/Octo.astro';
import site from '../data/site.json';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const first = site.lecons[0];
const nu = (t = '') => t.replace(/\s*\([^)]*\)/g, '');
---
<Base page="accueil">
  <section class="home">
    <div class="octo-host octo-home" data-octo><Octo /></div>
    <h1 class="home-titre" data-next-titre>Leçon {first.num} · {nu(clair(first).titre)}</h1>
    <p class="home-promesse">En 8 projets, tu fais tourner une boîte de 8 bots, sans salarié.</p>
    <p class="home-but" data-next-but>{clair(first).but}</p>
    <a class="btn btn-large btn-go" data-continuer href={`${base}lecon/${first.id}/`}>Commencer</a>
  </section>

  <div class="sheet" id="lecons" data-sheet hidden>
    <div class="sheet-in" role="dialog" aria-label="Toutes les leçons">
      <div class="sheet-tete"><h2>Leçons</h2><button type="button" class="x" data-sheet-close aria-label="Fermer">✕</button></div>
      {site.niveaux.map((niv) => {
        const lecs = site.lecons.filter((l) => l.niveau === niv.id);
        const quiz = site.quiz.find((q) => q.id === niv.quizId);
        return (
          <details class="niv" data-niveau-bloc={niv.id}>
            <summary><span class="niv-nom">{niv.id}. {nu(niv.nom)}</span><span class="niv-etat" data-niv-etat={niv.id}></span></summary>
            <ol class="liste-compacte">
              {lecs.map((l) => (
                <li class="item-lecon" data-lecon-carte={l.id}>
                  <a href={`${base}lecon/${l.id}/`}><span class="pastille" data-etat>{l.num}</span><span class="titre">{nu(l.court)}</span></a>
                </li>
              ))}
            </ol>
            {quiz && <a class="lien-quiz" href={`${base}quiz/${quiz.slug}/`} data-quiz-lien={quiz.id} data-quiz-niv={niv.id}>Quiz</a>}
          </details>
        );
      })}
      <p class="centre"><button class="lien" data-reset>Recommencer à zéro</button></p>
    </div>
  </div>
</Base>
