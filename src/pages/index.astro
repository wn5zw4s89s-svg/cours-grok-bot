---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const premiere = site.lecons.find((l) => l.disponible) || site.lecons[0];
---
<Base page="accueil">
  <section class="hero hero-min">
    <h1>Cours Grok Bot</h1>
    <div class="carte-progres">
      <div class="progres-ligne"><strong data-niveau-nom>Niveau 1 · Débutant</strong><span data-compte></span></div>
      <div class="barre"><span data-barre></span></div>
      <a class="btn btn-large" data-continuer href={`${base}lecon/${premiere.id}/`}>Continuer</a>
    </div>
  </section>

  {site.niveaux.map((niv) => {
    const lecs = site.lecons.filter((l) => l.niveau === niv.id);
    const quiz = site.quiz.find((q) => q.id === niv.quizId);
    return (
      <section class="bloc-min" data-niveau-bloc={niv.id}>
        <div class="niv-ligne">
          <h2>Niveau {niv.id} · {niv.nom}</h2>
          <span class="niv-count" data-niv-compte={niv.id}></span>
        </div>
        <div class="mini-barre large"><span data-niv-barre={niv.id}></span></div>
        <ol class="liste-compacte">
          {lecs.map((l) => (
            <li class:list={['item-lecon', { bientot: !l.disponible }]} data-lecon-carte={l.id}>
              {l.disponible ? (
                <a href={`${base}lecon/${l.id}/`}>
                  <span class="pastille" data-etat>{l.num}</span>
                  <span class="titre">{l.court}</span>
                  <span class="cadenas" aria-hidden="true">🔒</span>
                </a>
              ) : (
                <span class="bientot-ligne"><span class="pastille muted">{l.num}</span><span class="titre muted">Bientôt</span></span>
              )}
            </li>
          ))}
        </ol>
        {quiz ? (
          <a class="lien-quiz" href={`${base}quiz/${quiz.slug}/`} data-quiz-score={quiz.id}>Quiz</a>
        ) : (
          <span class="lien-quiz mute">Quiz · bientôt</span>
        )}
      </section>
    );
  })}

  <p class="discret centre"><button class="lien" data-reset>Recommencer</button></p>
  <div class="badges" data-badges hidden></div>
</Base>
