---
import Base from '../../layouts/Base.astro';
import lecons from '../../data/lecons.json';
export function getStaticPaths() {
  return lecons.map((l, i) => ({ params: { id: l.id }, props: { l, prev: lecons[i - 1], next: lecons[i + 1], i, n: lecons.length } }));
}
const { l, prev, next, i, n } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Base title={l.title} page="lecon">
  <article class="lecon" data-lecon={l.id} data-prev={prev?.id ?? ''}>
    <a class="retour" href={base}>← Toutes les leçons</a>
    <p class="surtitre">{l.num} · {i + 1} sur {n}</p>
    <h1>{l.court}</h1>
    <div class="verrou" hidden>
      <p class="gros">🔒</p>
      <p>Cette leçon se débloque quand tu as terminé <strong>{prev?.num}</strong>.</p>
      {prev && <a class="btn" href={`${base}lecon/${prev.id}/`}>Aller à {prev.num}</a>}
      <p><button class="lien" data-forcer>Je veux la lire quand même</button></p>
    </div>
    <div class="contenu" set:html={l.html} />
    <div class="fin-lecon">
      <button class="btn btn-large" data-terminer>J'ai terminé cette leçon</button>
      <p class="bravo" hidden>🎉 Bravo ! {next ? 'La leçon suivante est débloquée.' : 'Tu as fini toutes les leçons !'}</p>
      <div class="nav-lecons">
        {prev ? <a class="btn-sec" href={`${base}lecon/${prev.id}/`}>← {prev.num}</a> : <span />}
        {next ? <a class="btn-sec" data-suivante href={`${base}lecon/${next.id}/`}>{next.num} →</a> : <a class="btn-sec" href={base}>Accueil</a>}
      </div>
    </div>
  </article>
</Base>
