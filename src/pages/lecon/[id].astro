---
import { clair } from '../../lib/clair.js';
import Base from '../../layouts/Base.astro';
import site from '../../data/site.json';
import octo from '../../data/octoboss.json';
export function getStaticPaths() {
  const { lecons, quiz } = site;
  return lecons.map((l, i) => {
    const next = lecons[i + 1];
    const q = quiz.find((x) => x.niveau === l.niveau);
    const dernierDuNiveau = !next || next.niveau !== l.niveau;
    let suite;
    if (dernierDuNiveau && q) suite = { href: `quiz/${q.slug}/`, label: 'Terminé → Quiz' };
    else if (next) suite = { href: `lecon/${next.id}/`, label: `Terminé → Leçon ${next.num}` };
    else suite = { href: '', label: 'Terminé → Accueil' };
    return { params: { id: l.id }, props: { l, prev: lecons[i - 1], suite } };
  });
}
const { l, prev, suite } = Astro.props;
const c = clair(l);
const tent = octo.tentacules.find((t) => t.projet === l.niveau);
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Base title={l.title} page="lecon">
  <article class="lecon" data-lecon={l.id} data-num={l.num}>
    <div class="lh"><a class="retour" href={base} aria-label="Fermer">✕</a><div class="bar"><i data-barre-lecon></i></div></div>
    <h1 class="sr">Leçon {l.num} · {c.titre}</h1>
    <div class="verrou" hidden>
      <p>Termine d'abord la leçon {prev?.num}.</p>
      {prev && <a class="btn" href={`${base}lecon/${prev.id}/`}>Leçon {prev.num}</a>}
      <p><button class="lien" data-forcer>Lire quand même</button></p>
    </div>
    <div class="contenu" set:html={l.html} />
    <div class="fin-lecon">
      <button type="button" class="btn btn-large" data-suivant hidden>Continuer</button>
      <button type="button" class="btn btn-large" data-terminer data-suite={`${base}${suite.href}`}>Terminer</button>
    </div>
  </article>
</Base>
