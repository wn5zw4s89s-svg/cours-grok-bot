---
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const to = `${base}lecon/lecon-01/`;
---
<!doctype html>
<html lang="fr"><head><meta charset="utf-8" /><meta http-equiv="refresh" content={`0; url=${to}`} /><link rel="canonical" href={to} /><meta name="robots" content="noindex" /><title>Leçon 1</title><script is:inline define:vars={{ to }}>location.replace(to);</script></head>
<body><a href={to}>Aller à la leçon 1</a></body></html>
